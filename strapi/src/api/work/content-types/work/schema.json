{
  "kind": "collectionType",
  "collectionName": "works",
  "info": {
    "singularName": "work",
    "pluralName": "works",
    "displayName": "Work",
    "description": "Case studies: Home \"Works\" list (newest first) and /work/[slug] detail pages."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
