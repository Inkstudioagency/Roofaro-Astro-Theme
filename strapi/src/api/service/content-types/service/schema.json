{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service",
    "description": "Roofing services: Home slider, /portfolio grid and /services/[slug] detail pages."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "number": { "type": "integer", "required": true, "min": 1 },
    "summary": { "type": "text", "required": true },
    "thumbnail": { "type": "media", "multiple": false, "required": true, "allowedTypes": ["images"] },
    "keyPoints": { "type": "blocks" },
    "statNumber": { "type": "string", "required": true },
    "statText": { "type": "string", "required": true },
    "bannerImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "overviewTitle": { "type": "text" },
    "overviewImages": { "type": "media", "multiple": true, "allowedTypes": ["images"] },
    "overviewSummary": { "type": "text" },
    "solutionTitle": { "type": "string" },
    "solutionSummary": { "type": "text" },
    "solutionImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "solutionCards": { "type": "component", "repeatable": true, "component": "shared.feature-card" },
    "materialTitle": { "type": "string" },
    "materialSummary": { "type": "text" },
    "materialCards": { "type": "component", "repeatable": true, "component": "shared.feature-card" }
  }
}
