HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# --- Roofaro theme ---
# Strapi MCP server at /mcp (on by default in development).
MCP_ENABLED=true
# Allow SVG uploads (feature-card icons are SVG). Set to false to block SVG.
UPLOAD_ALLOW_SVG=true
# Grant the Public role read access to Service / Work on startup.
# Set to false if the site should read with a private STRAPI_API_TOKEN instead.
STRAPI_PUBLIC_READ=true
# Only needed for `npm run seed`: an Admin token (Settings → Admin tokens).
STRAPI_ADMIN_TOKEN=
