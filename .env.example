# Strapi server the site reads content from at build time (no trailing slash).
# Leave it empty to build with the bundled demo content (strapi/seed) and no CMS.
STRAPI_URL=http://localhost:1337
# Optional read-only API token (Strapi → Settings → API Tokens → Read-only).
# Leave empty if the Public role can read Service / Work (the default in /strapi).
STRAPI_API_TOKEN=
# Public URL of the deployed site, used for canonical URLs, Open Graph and the sitemap.
SITE_URL=https://example.com
# Endpoint for the contact form (Formspree, Web3Forms, Basin, your API…).
# Leave empty for demo mode (the form shows the success message without sending anything).
PUBLIC_FORM_ENDPOINT=
