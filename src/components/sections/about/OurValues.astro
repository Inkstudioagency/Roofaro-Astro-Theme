<section class="section_our-values">
  <div class="section-gap">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="our-values-wrapper">
        <div class="our-values-heading-block">
          <div class="section-heading-block">
            <div reveal-2s="" class="section-subtitle-block bottom-space">
              <div class="subtitle-dot"></div>
              <p class="subtitle-text">OUR VALUES</p>
            </div>
            <div class="section-title-block max-width-35">
              <h2 section-title="" class="heading-style-2">The Principles That Guide Every Project.</h2>
            </div>
            <div reveal-2s="" class="section-summary-block top-space">
              <p class="text-size-large">Our strong reputation is built on core values that shape every decision, every inspection, and every installation.</p>
            </div>
            <div reveal-4s="" class="section-button-block top-space">
              <Button kind="primary" href="/contact" text="Get a Quote" />
            </div>
          </div>
        </div>
