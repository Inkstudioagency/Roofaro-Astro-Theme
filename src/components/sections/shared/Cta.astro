---
import Button from '../../ui/Button.astro';
---

<section data-wf--section-cta--variant="bottom-gap" class="section_cta">
  <div class="section-gap bottom-gap">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="cta-wrapper">
        <div class="section-heading-block bottom-space-btwn bottom-gap-none">
          <div class="section-heading-text-block">
            <div reveal-0s="" class="section-subtitle-block with-bg bottom-space">
              <div class="subtitle-dot is-dark"></div>
              <p class="subtitle-text">REQUEST AN INSPECTION</p>
            </div>
            <div class="section-title-block max-width-30">
              <h2 section-title="" class="heading-style-2 title-animation">Your Roof Won’t Wait for the Next Storm.</h2>
            </div>
            <div reveal-2s="" class="section-summary-block top-space max-width-24">
              <p class="text-size-large text-weight-medium text-color-primary-700">PeakShield safeguards your property with dependable repairs, quality replacements, and detailed storm inspections.</p>
            </div>
          </div>
          <div reveal-4s="" class="section-button-block">
            <Button kind="secondary" variant="v2" href="/contact" text="Schedule Free Inspection" />
          </div>
        </div>
        <div class="cta-image-block"><img src="/images/CTA-Image-1.webp" loading="lazy" sizes="(max-width: 950px) 100vw, 950px" srcset="/images/CTA-Image-1-p-500.webp 500w, /images/CTA-Image-1-p-800.webp 800w, /images/CTA-Image-1.webp 950w" alt="Orange tiled roof with two chimneys and two skylight windows under sunlight." class="cta-image"></div>
      </div>
    </div>
  </div>
</section>
