---
/**
 * Password-protected page design (401). Static hosting can't check a password, so submitting
 * shows the "Incorrect password" state (see src/scripts/forms.ts). Protect real pages at the
 * host level (e.g. Vercel/Netlify password protection) and reuse this design.
 */
---

<div class="utility-page-wrap">
  <div class="protected-page-content w-password-page w-form">
    <form id="password-form" name="password-form" data-name="Password Form" class="utility-form-block w-password-page">
      <div class="utility-form-innner-block">
        <div class="utility-form-image-block"><img alt="Protected content illustration" src="/images/Protected-Image.avif" class="utility-form-image" /></div>
        <div class="utility-form-content-block">
          <div class="utility-form-text-block">
            <h1 class="protected-page-title">Protected Content</h1>
            <p class="protected-page-summary">This page is encrypted and requires a password to view. Please enter the access code provided by your administrator.</p>
          </div>
          <div class="utility-form-field-block"><label for="pass" class="utility-form-field-label w-password-page">Password</label><input class="utility-form-text-field w-password-page w-input" maxlength="256" name="pass" data-name="field" placeholder="Enter your password" type="password" id="pass" autocomplete="current-password" /></div>
          <div class="utility-form-button-block"><input type="submit" data-wait="Please wait..." class="utility-form-button w-password-page w-button" value="Submit" /></div>
          <div class="utility-form-bottom-block">
            <p class="utility-form-bottom-text">Forgot your password?</p>
            <a href="/contact" class="utility-form-bottom-link">Contact Support</a>
          </div>
        </div>
      </div>
      <div class="w-password-page w-form-fail">
        <div>Incorrect password. Please try again.</div>
      </div>
    </form>
  </div>
</div>
