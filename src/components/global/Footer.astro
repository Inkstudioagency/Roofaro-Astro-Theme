---
import { site } from '../../config/site';
import { footerQuickLinks, footerUtilityLinks, footerBottomLinks, isCurrent, type NavLink } from '../../config/navigation';
import { getServices, getWorks, serviceHref, workHref } from '../../lib/cms';

const path = Astro.url.pathname;
const [services, works] = await Promise.all([getServices(), getWorks()]);

// The "Service Details" / "Work Details" demo links point at the first CMS entries.
const resolve = (link: NavLink): NavLink => {
  if (link.href === '{firstService}') return { ...link, href: services[0] ? serviceHref(services[0]) : '/portfolio' };
  if (link.href === '{firstWork}') return { ...link, href: works[0] ? workHref(works[0]) : '/#section_works' };
  return link;
};
const quickLinks = footerQuickLinks.map(resolve);
const current = (href: string) => isCurrent(href, path);
---

<footer class="section_footer">
  <div class="w-layout-blockcontainer container-main w-container">
    <div class="footer-wrapper">
      <div class="footer-content-block">
        <div to-top-6="" class="footer-main-content-block">
          <div class="footer-info-content-block">
            <div class="footer-info-text-block">
              <a href="/" aria-current={current('/') ? 'page' : undefined} class:list={['footer-logo-block w-inline-block', current('/') && 'w--current']}><img src={site.logoLight.src} loading="lazy" alt={site.logoLight.alt} class="footer-logo" /></a>
              <div class="footer-summary-block">
                <p class="text-size-large text-color-white-800">{site.footerSummary}</p>
              </div>
            </div>
            <div class="footer-social-info-block">
              {site.social.map((s) => (
                <a aria-label={s.label} href={s.href} target="_blank" rel="noopener" class="footer-social-icon-block w-inline-block">
                  <div class="footer-social-icon w-embed">
                    {s.icon === 'facebook' && (
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M12.0001 1.33203H10.0001C9.11603 1.33203 8.26818 1.68322 7.64306 2.30834C7.01794 2.93346 6.66675 3.78131 6.66675 4.66536V6.66536H4.66675V9.33203H6.66675V14.6654H9.33341V9.33203H11.3334L12.0001 6.66536H9.33341V4.66536C9.33341 4.48855 9.40365 4.31898 9.52868 4.19396C9.6537 4.06894 9.82327 3.9987 10.0001 3.9987H12.0001V1.33203Z" stroke="white" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg>
                    )}
                    {s.icon === 'x' && (
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M2 14L7.03226 8.96774M14 2L8.96774 7.03226M7.03226 8.96774L10.6667 14H14L8.96774 7.03226L5.33333 2H2L7.03226 8.96774Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg>
                    )}
                    {s.icon === 'instagram' && (
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <g clip-path="url(#clip0_212_2826)">
                          <path d="M11.3333 1.33203H4.66658C2.82564 1.33203 1.33325 2.82442 1.33325 4.66536V11.332C1.33325 13.173 2.82564 14.6654 4.66658 14.6654H11.3333C13.1742 14.6654 14.6666 13.173 14.6666 11.332V4.66536C14.6666 2.82442 13.1742 1.33203 11.3333 1.33203Z" stroke="white" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                          <path d="M10.6666 7.5802C10.7488 8.13503 10.6541 8.70168 10.3957 9.19954C10.1374 9.69741 9.72865 10.1011 9.22764 10.3533C8.72662 10.6055 8.15885 10.6933 7.60508 10.6042C7.0513 10.515 6.53973 10.2536 6.14311 9.85698C5.7465 9.46036 5.48504 8.94878 5.39593 8.39501C5.30682 7.84124 5.3946 7.27346 5.64677 6.77245C5.89894 6.27144 6.30268 5.86269 6.80054 5.60436C7.29841 5.34603 7.86506 5.25126 8.41989 5.33353C8.98583 5.41746 9.50979 5.68118 9.91435 6.08574C10.3189 6.4903 10.5826 7.01425 10.6666 7.5802Z" stroke="white" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                          <path d="M11.6667 4.33203H11.6734" stroke="white" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                        </g>
                        <defs>
                          <clipPath id="clip0_212_2826">
                            <rect width="16" height="16" fill="white"></rect>
                          </clipPath>
                        </defs>
                      </svg>
                    )}
                    {s.icon === 'linkedin' && (
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M10.6667 5.33203C11.7276 5.33203 12.745 5.75346 13.4952 6.5036C14.2453 7.25375 14.6667 8.27117 14.6667 9.33203V13.9987H12.0001V9.33203C12.0001 8.97841 11.8596 8.63927 11.6096 8.38922C11.3595 8.13917 11.0204 7.9987 10.6667 7.9987C10.3131 7.9987 9.97399 8.13917 9.72394 8.38922C9.47389 8.63927 9.33341 8.97841 9.33341 9.33203V13.9987H6.66675V9.33203C6.66675 8.27117 7.08818 7.25375 7.83832 6.5036C8.58847 5.75346 9.60588 5.33203 10.6667 5.33203Z" stroke="white" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                        <path d="M3.99992 6H1.33325V14H3.99992V6Z" stroke="white" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                        <path d="M2.66659 3.9987C3.40297 3.9987 3.99992 3.40174 3.99992 2.66536C3.99992 1.92898 3.40297 1.33203 2.66659 1.33203C1.93021 1.33203 1.33325 1.92898 1.33325 2.66536C1.33325 3.40174 1.93021 3.9987 2.66659 3.9987Z" stroke="white" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg>
                    )}
                  </div>
                </a>
              ))}
            </div>
          </div>
          <div class="footer-link-content-block">
            <div class="footer-link-block">
              <div class="footer-link-title">Quick Links</div>
              {quickLinks.map((link) => (
                <a href={link.href} aria-current={current(link.href) ? 'page' : undefined} class:list={['footer-link w-inline-block', current(link.href) && 'w--current']}>
                  <div class="link-text">{link.label}</div>
                </a>
              ))}
            </div>
            <div class="footer-link-block">
              <div class="footer-link-title">Utility Links</div>
              {footerUtilityLinks.map((link) => (
                <a href={link.href} aria-current={current(link.href) ? 'page' : undefined} class:list={['footer-link w-inline-block', current(link.href) && 'w--current']}>
                  <div class="link-text">{link.label}</div>
                </a>
              ))}
            </div>
            <div class="footer-contact-info-block">
              <div class="footer-link-title">Contact</div>
              <div class="footer-contact-single-block">
                <div class="footer-contact-text-block">
                  <div class="paragraph-xsmall text-color-white">Email Address</div>
                  <a href={`mailto:${site.contact.email}`} class="footer-contact-link">{site.contact.email}</a>
                </div>
              </div>
              <div class="footer-contact-single-block">
                <div class="footer-contact-text-block">
                  <div class="paragraph-xsmall text-color-white">Phone Number</div>
                  <a href={`tel:${site.contact.phoneHref}`} class="footer-contact-link">{site.contact.phone}</a>
                </div>
              </div>
              <div class="footer-contact-single-block">
                <div class="footer-contact-text-block">
                  <div class="paragraph-xsmall text-color-white">Address</div>
                  <div class="footer-contact-link hover-none">{site.contact.address}</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="footer-bottom-block">
        <div class="footer-logo-content-block"><img loading="lazy" src={site.footerWordmark.src} alt={site.footerWordmark.alt} class="footer-bottom-logo" /></div>
        <div class="footer-bottom-content-block">
          <div class="copyright-text-block">
            <p class="paragraph-small text-color-white mobile-middle">{site.copyright} | Designed by <a href={site.credits.designedBy.href} target="_blank" rel="noopener" class="text-color-white text-weight-semibold hover">{site.credits.designedBy.label}</a> - Powered by <a href={site.credits.poweredBy.href} target="_blank" rel="noopener" class="text-color-white text-weight-semibold hover">{site.credits.poweredBy.label}</a>
            </p>
          </div>
          <div class="footer-bottom-link-block">
            {footerBottomLinks.map((link, i) => (
              <a href={link.href} aria-current={current(link.href) ? 'page' : undefined} class:list={['footer-link w-inline-block', current(link.href) && 'w--current']}>
                <div class:list={['link-text', i === 0 && 'is-1']}>{link.label}</div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
