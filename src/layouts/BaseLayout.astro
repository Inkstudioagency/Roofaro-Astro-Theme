---
import '../styles/normalize.css';
import '../styles/webflow.css';
import '../styles/roofaro-astro-theme.webflow.css';
import '../styles/lenis.css';
import '../styles/custom.css';
import ix3InitialStates from '../styles/ix3-initial-states.css?raw';
import SEO from '../components/global/SEO.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import { site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /**
   * Original page id. The interaction runtime (public/js/webflow.js) scopes each page's
   * animations to this id, so every page passes one of the ids in `wfPages` (config/site.ts).
   */
  wfPage: string;
  /**
   * `default`: page-wrapper + header + footer.
   * `utility`: 404 layout (utility-page-wrapper, header variant v2).
   * `bare`: no header/footer (401 password page).
   */
  layout?: 'default' | 'utility' | 'bare';
  /** Optional JSON-LD object rendered in <head>. */
  jsonLd?: Record<string, unknown>;
}

const { title, description, image, type, noindex, wfPage, layout = 'default', jsonLd } = Astro.props;
---

<!doctype html>
<html data-wf-page={wfPage} data-wf-site={site.webflowSiteId} lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <SEO title={title} description={description} image={image} type={type} noindex={noindex} />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta name="generator" content={Astro.generator} />
    <style is:inline set:html={ix3InitialStates}></style>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <script is:inline>!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
    <link href="/images/favicon.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: light)" />
    <link href="/images/favicon-dark.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)" />
    <link href="/images/favicon-48.png" rel="icon" type="image/png" sizes="48x48" />
    <link href="/images/webclip-180.png" rel="apple-touch-icon" sizes="180x180" />
    <link href="/images/webclip-192.png" rel="icon" type="image/png" sizes="192x192" />
    <link href="/images/webclip.png" rel="icon" type="image/png" sizes="512x512" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    {layout === 'bare' && <slot />}
    {layout === 'utility' && (
      <div class="utility-page-wrapper">
        <Header variant="v2" />
        <div class="main-wrapper">
          <slot />
        </div>
        <Footer />
      </div>
    )}
    {layout === 'default' && (
      <div class="page-wrapper">
        <Header />
        <main class="main-wrapper">
          <slot />
        </main>
        <Footer />
      </div>
    )}
    <!-- Interaction runtime + GSAP + Lenis, self-hosted (see README → "Animations"). -->
    <script is:inline src="/js/jquery-3.5.1.min.js"></script>
    <script is:inline src="/js/webflow.js"></script>
    <script is:inline src="/js/gsap.min.js"></script>
    <script is:inline src="/js/SplitText.min.js"></script>
    <script is:inline src="/js/ScrollTrigger.min.js"></script>
    <script is:inline>gsap.registerPlugin(SplitText,ScrollTrigger);</script>
    <script is:inline src="/js/lenis.min.js"></script>
    <script is:inline src="/js/roofaro.js"></script>
    <script>
      import '../scripts/forms';
    </script>
  </body>
</html>
